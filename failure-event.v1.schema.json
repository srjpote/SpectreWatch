{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpectreWatch Failure Event v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "correlationId",
    "sourcePlatform",
    "automationName",
    "runId",
    "occurredAt",
    "classification",
    "errorCode",
    "errorMessageRedacted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string"
    },
    "sourcePlatform": {
      "enum": [
        "PowerAutomateCloud",
        "PowerAutomateDesktop",
        "UiPath",
        "Other"
      ]
    },
    "automationName": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "failedAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "enum": [
        "business_exception",
        "credentials",
        "timeout",
        "system_error",
        "unknown"
      ]
    },
    "errorCode": {
      "type": "string"
    },
    "errorMessageRedacted": {
      "type": "string",
      "maxLength": 4000
    },
    "businessReference": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
