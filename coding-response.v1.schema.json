{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Proposal Response v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "testsRun",
    "humanApprovalRequired"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "proposal_created",
        "no_safe_change",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "pullRequestUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testsRun": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "humanApprovalRequired": {
      "const": true
    }
  },
  "additionalProperties": false
}
