{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Proposal Request v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "incidentId",
    "repositoryUrl",
    "diagnosis",
    "confidence",
    "evidenceRefs",
    "mode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "incidentId": {
      "type": "string"
    },
    "repositoryUrl": {
      "type": "string",
      "format": "uri"
    },
    "diagnosis": {
      "type": "string",
      "maxLength": 4000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "const": "draft_pr_only"
    },
    "allowedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
